<section class="tessilo-story page-width" aria-labelledby="TessiloStory-{{ section.id }}">
  <div class="tessilo-story__heading"><p class="tessilo-overline">Living with Tessilo</p><h2 id="TessiloStory-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
  <div class="tessilo-story__image">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 1500 | image_tag: widths: '600, 900, 1500', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy' }}
  {% else %}
    <img src="{{ 'tessilo-living.png' | asset_url }}" width="1024" height="1536" alt="Ivory modular sofa and movable ottoman in a lived-in room" loading="lazy">
  {% endif %}
  </div>
  <div class="tessilo-story__copy"><p>{{ section.settings.description | escape }}</p><a class="tessilo-text-link" href="{{ routes.all_products_collection_url }}">Find your piece <span aria-hidden="true">↗</span></a></div>
</section>
{% schema %}
{"name":"Tessilo living story","settings":[
{"type":"text","id":"heading","label":"Heading","default":"Room for your everyday rituals."},
{"type":"textarea","id":"description","label":"Description","default":"A slow morning. A favorite book. A conversation that lasts a little longer. Make a place for the moments you want to come home to."},
{"type":"image_picker","id":"image","label":"Lifestyle image"}],"presets":[{"name":"Tessilo living story"}]}
{% endschema %}
