{% assign item = section.settings.product %}{% assign scene_image = item.images[1] | default: item.featured_image %}
<section class="tessilo-setting-hero"><div><a class="tessilo-setting-hero__back" href="{{ routes.root_url }}#TessiloScenes">Explore the settings</a><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.description | escape }}</p><a class="button" href="#TessiloScenes">Shop this setting</a></div><div>{{ scene_image | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 750px) 48vw, 100vw', loading: 'eager' }}</div></section>
{% schema %}{"name":"Tessilo setting cover","settings":[{"type":"product","id":"product","label":"Scene product"},{"type":"text","id":"heading","label":"Heading"},{"type":"textarea","id":"description","label":"Description"}],"presets":[{"name":"Tessilo setting cover"}]}{% endschema %}
