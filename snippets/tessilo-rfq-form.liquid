{% liquid
  assign rfq_id = 'TessiloRFQForm-' | append: section.id
  assign rfq_variant = product.selected_or_first_available_variant
%}
<div class="tessilo-rfq{% if product != blank %} tessilo-rfq--product{% else %} tessilo-rfq--contact{% endif %}" id="TessiloRFQ" data-rfq data-grow-form-id="a9de5978-5b2f-4c5c-8e19-cf76c0b8d676" data-section="{{ section.id }}" data-product-bound="{% if product != blank %}true{% else %}false{% endif %}">
{% if product != blank %}
  <button type="button" class="tessilo-rfq__launch" data-rfq-open aria-haspopup="dialog" aria-controls="{{ rfq_id }}-dialog">Request a custom / bulk quote <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5"/></svg></button>
  <dialog id="{{ rfq_id }}-dialog" class="tessilo-rfq__dialog" aria-labelledby="{{ rfq_id }}-title" data-rfq-dialog>
  <header class="tessilo-rfq__dialog-head"><h2 id="{{ rfq_id }}-title">Make it yours.</h2><button type="button" data-rfq-close aria-label="Close enquiry"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.5"/></svg></button></header>
{% endif %}
<form id="{{ rfq_id }}" class="tessilo-rfq__form" data-rfq-form onsubmit="return false">
  <div class="tessilo-rfq__content">
    {% if product == blank %}<h2>Tell us what you have in mind.</h2>{% endif %}
    {% if product == blank %}<p class="tessilo-rfq__intro">A custom piece or a larger order? Tell us a little about your plans.</p>{% else %}<div class="tessilo-rfq__piece">{% if product.featured_image %}{{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160' }}{% endif %}<div><strong>{{ product.title | escape }}</strong><span data-rfq-reference>{{ rfq_variant.sku | escape }} · {{ rfq_variant.title | escape }}</span><small>This piece is included in your request.</small></div></div>{% endif %}
{% if product == blank %}
    <div class="tessilo-rfq__grid">
<fieldset class="tessilo-rfq__types tessilo-rfq__wide"><legend>How can we help?</legend><div><label class="tessilo-rfq__type"><input type="radio" name="contact[inquiry_type]" value="custom_furniture" data-rfq-field="inquiry_type" required checked><span><strong>Custom furniture</strong></span></label><label class="tessilo-rfq__type"><input type="radio" name="contact[inquiry_type]" value="wholesale" data-rfq-field="inquiry_type" required><span><strong>Bulk / wholesale</strong></span></label><label class="tessilo-rfq__type"><input type="radio" name="contact[inquiry_type]" value="designer_project" data-rfq-field="inquiry_type" required><span><strong>Designer / project</strong></span></label><label class="tessilo-rfq__type"><input type="radio" name="contact[inquiry_type]" value="general" data-rfq-field="inquiry_type" required><span><strong>General question</strong></span></label></div></fieldset>

      <label for="{{ rfq_id }}-name">Your name <span aria-hidden="true">*</span><input id="{{ rfq_id }}-name" name="contact[name]" autocomplete="name" required maxlength="150" value="{{ customer.name | escape }}"></label>
      <label for="{{ rfq_id }}-email">Email <span aria-hidden="true">*</span><input id="{{ rfq_id }}-email" type="email" name="contact[email]" autocomplete="email" required maxlength="254" value="{{ customer.email | escape }}" ></label>
      <label for="{{ rfq_id }}-quantity">Quantity <span aria-hidden="true">*</span><input id="{{ rfq_id }}-quantity" name="contact[quantity]" type="number" inputmode="numeric" min="1" max="1000000000" step="1" required value="1" data-rfq-field="quantity"></label>
      <div class="tessilo-country" data-country><label for="{{ rfq_id }}-country" data-country-label>Delivery country / region <span aria-hidden="true">*</span></label><select id="{{ rfq_id }}-country" name="contact[country]" autocomplete="country" required data-country-fallback><option value="">Choose country / region</option><option value="US" data-country-name="United States">🇺🇸 United States</option><option value="AL" data-country-name="Albania">🇦🇱 Albania</option><option value="AD" data-country-name="Andorra">🇦🇩 Andorra</option><option value="AT" data-country-name="Austria">🇦🇹 Austria</option><option value="BY" data-country-name="Belarus">🇧🇾 Belarus</option><option value="BE" data-country-name="Belgium">🇧🇪 Belgium</option><option value="BA" data-country-name="Bosnia &amp; Herzegovina">🇧🇦 Bosnia &amp; Herzegovina</option><option value="GB" data-country-name="Britain (UK)">🇬🇧 Britain (UK)</option><option value="BG" data-country-name="Bulgaria">🇧🇬 Bulgaria</option><option value="HR" data-country-name="Croatia">🇭🇷 Croatia</option><option value="CY" data-country-name="Cyprus">🇨🇾 Cyprus</option><option value="CZ" data-country-name="Czechia">🇨🇿 Czechia</option><option value="DK" data-country-name="Denmark">🇩🇰 Denmark</option><option value="EE" data-country-name="Estonia">🇪🇪 Estonia</option><option value="FI" data-country-name="Finland">🇫🇮 Finland</option><option value="FR" data-country-name="France">🇫🇷 France</option><option value="DE" data-country-name="Germany">🇩🇪 Germany</option><option value="GR" data-country-name="Greece">🇬🇷 Greece</option><option value="HU" data-country-name="Hungary">🇭🇺 Hungary</option><option value="IS" data-country-name="Iceland">🇮🇸 Iceland</option><option value="IE" data-country-name="Ireland">🇮🇪 Ireland</option><option value="IT" data-country-name="Italy">🇮🇹 Italy</option><option value="XK" data-country-name="Kosovo">🇽🇰 Kosovo</option><option value="LV" data-country-name="Latvia">🇱🇻 Latvia</option><option value="LI" data-country-name="Liechtenstein">🇱🇮 Liechtenstein</option><option value="LT" data-country-name="Lithuania">🇱🇹 Lithuania</option><option value="LU" data-country-name="Luxembourg">🇱🇺 Luxembourg</option><option value="MT" data-country-name="Malta">🇲🇹 Malta</option><option value="MD" data-country-name="Moldova">🇲🇩 Moldova</option><option value="MC" data-country-name="Monaco">🇲🇨 Monaco</option><option value="ME" data-country-name="Montenegro">🇲🇪 Montenegro</option><option value="NL" data-country-name="Netherlands">🇳🇱 Netherlands</option><option value="MK" data-country-name="North Macedonia">🇲🇰 North Macedonia</option><option value="NO" data-country-name="Norway">🇳🇴 Norway</option><option value="PL" data-country-name="Poland">🇵🇱 Poland</option><option value="PT" data-country-name="Portugal">🇵🇹 Portugal</option><option value="RO" data-country-name="Romania">🇷🇴 Romania</option><option value="RU" data-country-name="Russia">🇷🇺 Russia</option><option value="SM" data-country-name="San Marino">🇸🇲 San Marino</option><option value="RS" data-country-name="Serbia">🇷🇸 Serbia</option><option value="SK" data-country-name="Slovakia">🇸🇰 Slovakia</option><option value="SI" data-country-name="Slovenia">🇸🇮 Slovenia</option><option value="ES" data-country-name="Spain">🇪🇸 Spain</option><option value="SE" data-country-name="Sweden">🇸🇪 Sweden</option><option value="CH" data-country-name="Switzerland">🇨🇭 Switzerland</option><option value="TR" data-country-name="Türkiye">🇹🇷 Türkiye</option><option value="UA" data-country-name="Ukraine">🇺🇦 Ukraine</option><option value="VA" data-country-name="Vatican City">🇻🇦 Vatican City</option></select><div class="tessilo-country__custom" hidden data-country-custom><div class="tessilo-country__control"><input id="{{ rfq_id }}-country-search" data-country-search role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="{{ rfq_id }}-country-options" autocomplete="off" placeholder="Search country / region" required disabled><span aria-hidden="true">⌄</span></div><ul id="{{ rfq_id }}-country-options" class="tessilo-country__options" role="listbox" aria-label="Delivery country or region" hidden data-country-options></ul><p class="visually-hidden" role="status" data-country-status></p></div><small class="tessilo-country__note">Enquiry destinations; delivery availability is confirmed individually.</small></div>
      <div class="tessilo-rfq__wide tessilo-piece-picker" data-piece-picker>
        <span class="tessilo-rfq__label" id="{{ rfq_id }}-piece-label">Piece / style <span>(optional)</span></span>
        <details data-piece-disclosure><summary aria-labelledby="{{ rfq_id }}-piece-label {{ rfq_id }}-piece-value"><span class="tessilo-piece-picker__selection"><img data-piece-preview hidden alt="" width="48" height="56"><span><strong id="{{ rfq_id }}-piece-value" data-piece-title>Choose a piece</strong><small data-piece-reference>Browse by image, name or SKU</small></span></span><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 7 5 5 5-5" stroke="currentColor" stroke-width="1.5"/></svg></summary>
        <div class="tessilo-piece-picker__panel"><input type="search" data-piece-search aria-label="Search pieces by name or SKU" placeholder="Search name or SKU" autocomplete="off"><div class="tessilo-piece-picker__options" data-piece-options>
        <button type="button" data-piece-option data-sku="" data-title="" data-url="" data-variant="" data-variant-title=""><span>No specific piece yet</span></button>
        {% for piece in collections.all.products limit: 50 %}{% for variant in piece.variants %}{% assign piece_image = variant.featured_image | default: piece.featured_image %}
        <button type="button" data-piece-option data-sku="{{ variant.sku | escape }}" data-title="{{ piece.title | escape }}" data-url="{{ shop.url }}{{ piece.url }}" data-variant="{{ variant.id }}" data-variant-title="{{ variant.title | escape }}"{% if piece_image %} data-image="{{ piece_image | image_url: width: 120 }}"{% endif %}>
          {% if piece_image %}{{ piece_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '60,120', alt: '' }}{% endif %}<span><strong>{{ piece.title | escape }}</strong><small>{{ variant.sku | escape }}{% unless variant.title == 'Default Title' %} · {{ variant.title | escape }}{% endunless %}</small></span>
        </button>{% endfor %}{% endfor %}
        </div><p data-piece-empty hidden role="status">No matching piece. Try a different name or SKU.</p></div></details>
        <input type="hidden" name="contact[product_title]" data-rfq-field="product_title"><input type="hidden" name="contact[product_sku]" data-rfq-field="product_sku">
      </div>
      <label class="tessilo-rfq__wide" for="{{ rfq_id }}-notes">Tell us about your enquiry <span aria-hidden="true">*</span><textarea id="{{ rfq_id }}-notes" name="contact[body]" data-rfq-field="notes" rows="3" maxlength="3600" required placeholder="Tell us about quantities, custom finishes, room measurements or your project."></textarea></label>
      <details class="tessilo-rfq__extra tessilo-rfq__wide"><summary>Add company, city or timing <span>(optional)</span></summary><div class="tessilo-rfq__grid">
      <label for="{{ rfq_id }}-company">Company / studio <span>(optional)</span><input id="{{ rfq_id }}-company" name="contact[company]" autocomplete="organization" maxlength="200" value=""></label>
      <label for="{{ rfq_id }}-location">City / delivery location<input id="{{ rfq_id }}-location" name="contact[delivery_location]" autocomplete="address-level2" maxlength="250" value=""></label>
      <label for="{{ rfq_id }}-timeline">Preferred timing <span>(optional)</span><input id="{{ rfq_id }}-timeline" name="contact[timeline]" maxlength="200" placeholder="For example, planning for September" value=""></label>
</div></details>
    </div>
{% else %}
    <div class="tessilo-rfq__grid">
      <label for="{{ rfq_id }}-name">Your name *<input id="{{ rfq_id }}-name" name="contact[name]" autocomplete="name" required maxlength="150" value="{{ customer.name | escape }}"></label>
      <label for="{{ rfq_id }}-email">Email *<input id="{{ rfq_id }}-email" type="email" name="contact[email]" autocomplete="email" required maxlength="254" value="{{ customer.email | escape }}"></label>
      <div class="tessilo-rfq__wide"><span class="tessilo-rfq__label" id="{{ rfq_id }}-role-label">I’m choosing for</span><details class="tessilo-rfq__role" data-rfq-role><summary aria-labelledby="{{ rfq_id }}-role-label {{ rfq_id }}-role-value"><span id="{{ rfq_id }}-role-value" data-rfq-role-label>My home</span><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 7 5 5 5-5" stroke="currentColor" stroke-width="1.5"/></svg></summary><fieldset><legend class="visually-hidden">Your enquiry role</legend>
      <label><input type="radio" name="contact[buyer_role]" aria-label="Dealer / distributor" value="Dealer / distributor" data-intent="wholesale">Dealer / distributor</label>
      <label><input type="radio" name="contact[buyer_role]" aria-label="Agent" value="Agent" data-intent="wholesale">Agent</label>
      <label><input type="radio" name="contact[buyer_role]" aria-label="Retailer" value="Retailer" data-intent="wholesale">Retailer</label>
      <label><input type="radio" name="contact[buyer_role]" aria-label="Project buyer" value="Project buyer" data-intent="designer_project">Project buyer</label>
      <label><input type="radio" name="contact[buyer_role]" aria-label="My home" value="My home" data-intent="custom_furniture" checked>My home</label>
      <label><input type="radio" name="contact[buyer_role]" aria-label="Retail / wholesale" value="Retail / wholesale" data-intent="wholesale">Retail / wholesale</label>
      <label><input type="radio" name="contact[buyer_role]" aria-label="Design / hotel project" value="Design / hotel project" data-intent="designer_project">Design / hotel project</label>
      </fieldset></details><input type="hidden" name="contact[inquiry_type]" value="custom_furniture" data-rfq-field="inquiry_type"></div>
      <label class="tessilo-rfq__wide" for="{{ rfq_id }}-notes">What do you have in mind? *<textarea id="{{ rfq_id }}-notes" name="contact[body]" data-rfq-field="notes" rows="3" maxlength="3600" required placeholder="Tell us about your order, custom finishes or partnership plans."></textarea></label>
      <div class="tessilo-country" data-country><label for="{{ rfq_id }}-country" data-country-label>Delivery country / region <span aria-hidden="true">*</span></label><select id="{{ rfq_id }}-country" name="contact[country]" autocomplete="country" required data-country-fallback><option value="">Choose country / region</option><option value="US" data-country-name="United States">🇺🇸 United States</option><option value="AL" data-country-name="Albania">🇦🇱 Albania</option><option value="AD" data-country-name="Andorra">🇦🇩 Andorra</option><option value="AT" data-country-name="Austria">🇦🇹 Austria</option><option value="BY" data-country-name="Belarus">🇧🇾 Belarus</option><option value="BE" data-country-name="Belgium">🇧🇪 Belgium</option><option value="BA" data-country-name="Bosnia &amp; Herzegovina">🇧🇦 Bosnia &amp; Herzegovina</option><option value="GB" data-country-name="Britain (UK)">🇬🇧 Britain (UK)</option><option value="BG" data-country-name="Bulgaria">🇧🇬 Bulgaria</option><option value="HR" data-country-name="Croatia">🇭🇷 Croatia</option><option value="CY" data-country-name="Cyprus">🇨🇾 Cyprus</option><option value="CZ" data-country-name="Czechia">🇨🇿 Czechia</option><option value="DK" data-country-name="Denmark">🇩🇰 Denmark</option><option value="EE" data-country-name="Estonia">🇪🇪 Estonia</option><option value="FI" data-country-name="Finland">🇫🇮 Finland</option><option value="FR" data-country-name="France">🇫🇷 France</option><option value="DE" data-country-name="Germany">🇩🇪 Germany</option><option value="GR" data-country-name="Greece">🇬🇷 Greece</option><option value="HU" data-country-name="Hungary">🇭🇺 Hungary</option><option value="IS" data-country-name="Iceland">🇮🇸 Iceland</option><option value="IE" data-country-name="Ireland">🇮🇪 Ireland</option><option value="IT" data-country-name="Italy">🇮🇹 Italy</option><option value="XK" data-country-name="Kosovo">🇽🇰 Kosovo</option><option value="LV" data-country-name="Latvia">🇱🇻 Latvia</option><option value="LI" data-country-name="Liechtenstein">🇱🇮 Liechtenstein</option><option value="LT" data-country-name="Lithuania">🇱🇹 Lithuania</option><option value="LU" data-country-name="Luxembourg">🇱🇺 Luxembourg</option><option value="MT" data-country-name="Malta">🇲🇹 Malta</option><option value="MD" data-country-name="Moldova">🇲🇩 Moldova</option><option value="MC" data-country-name="Monaco">🇲🇨 Monaco</option><option value="ME" data-country-name="Montenegro">🇲🇪 Montenegro</option><option value="NL" data-country-name="Netherlands">🇳🇱 Netherlands</option><option value="MK" data-country-name="North Macedonia">🇲🇰 North Macedonia</option><option value="NO" data-country-name="Norway">🇳🇴 Norway</option><option value="PL" data-country-name="Poland">🇵🇱 Poland</option><option value="PT" data-country-name="Portugal">🇵🇹 Portugal</option><option value="RO" data-country-name="Romania">🇷🇴 Romania</option><option value="RU" data-country-name="Russia">🇷🇺 Russia</option><option value="SM" data-country-name="San Marino">🇸🇲 San Marino</option><option value="RS" data-country-name="Serbia">🇷🇸 Serbia</option><option value="SK" data-country-name="Slovakia">🇸🇰 Slovakia</option><option value="SI" data-country-name="Slovenia">🇸🇮 Slovenia</option><option value="ES" data-country-name="Spain">🇪🇸 Spain</option><option value="SE" data-country-name="Sweden">🇸🇪 Sweden</option><option value="CH" data-country-name="Switzerland">🇨🇭 Switzerland</option><option value="TR" data-country-name="Türkiye">🇹🇷 Türkiye</option><option value="UA" data-country-name="Ukraine">🇺🇦 Ukraine</option><option value="VA" data-country-name="Vatican City">🇻🇦 Vatican City</option></select><div class="tessilo-country__custom" hidden data-country-custom><div class="tessilo-country__control"><input id="{{ rfq_id }}-country-search" data-country-search role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="{{ rfq_id }}-country-options" autocomplete="off" placeholder="Search country / region" required disabled><span aria-hidden="true">⌄</span></div><ul id="{{ rfq_id }}-country-options" class="tessilo-country__options" role="listbox" aria-label="Delivery country or region" hidden data-country-options></ul><p class="visually-hidden" role="status" data-country-status></p></div><small class="tessilo-country__note">Enquiry destinations; delivery availability is confirmed individually.</small></div>
      <label for="{{ rfq_id }}-quantity">Quantity *<input id="{{ rfq_id }}-quantity" name="contact[quantity]" type="number" min="1" max="1000000000" step="1" required value="1" data-rfq-field="quantity"></label>
      <details class="tessilo-rfq__extra tessilo-rfq__wide"><summary>Add company or delivery details <span>(optional)</span></summary><div class="tessilo-rfq__grid">
      <label for="{{ rfq_id }}-company">Company / studio<input id="{{ rfq_id }}-company" name="contact[company]" autocomplete="organization" maxlength="200"></label>
      <label for="{{ rfq_id }}-location">City / delivery location<input id="{{ rfq_id }}-location" name="contact[delivery_location]" autocomplete="address-level2" maxlength="250"></label>
      <label class="tessilo-rfq__wide" for="{{ rfq_id }}-timeline">Preferred timing<input id="{{ rfq_id }}-timeline" name="contact[timeline]" maxlength="200"></label></div></details>
    </div>
    <input type="hidden" name="contact[product_title]" data-rfq-field="product_title" value="{{ product.title | escape }}">
    <input type="hidden" name="contact[product_sku]" data-rfq-field="product_sku" value="{{ rfq_variant.sku | escape }}">
{% endif %}
    <input type="hidden" name="contact[product_url]" data-rfq-field="product_url" value="{% if product != blank %}{{ shop.url }}{{ product.url }}{% endif %}">
    <input type="hidden" name="contact[variant_id]" data-rfq-field="variant_id" value="{{ rfq_variant.id }}">
    <input type="hidden" name="contact[variant_title]" data-rfq-field="variant_title" value="{{ rfq_variant.title | escape }}">
    <input type="hidden" name="contact[source]" value="Tessilo Shopify brand enquiry">
    <p class="tessilo-rfq__privacy">We’ll use these details to respond to your enquiry.{% if shop.privacy_policy.body != blank %} <a href="{{ shop.privacy_policy.url }}">Privacy policy</a>.{% endif %} Please do not include payment details.</p>
    <div data-grow-status role="status" aria-live="polite">Loading enquiry service…</div>
    <button class="button tessilo-rfq__submit" type="submit" disabled>Send enquiry</button><p class="tessilo-rfq__footnote">This is an enquiry, not an order. Custom options and delivery arrangements require confirmation.</p>
  </div>
</form>
{% if product != blank %}</dialog>{% endif %}
</div>
